# Copy to .env and fill in the secret. .env is git-ignored.

# Base URL of the n8n instance, up to and including /webhook (no trailing slash).
N8N_BASE_URL=https://your-instance.app.n8n.cloud/webhook

# Webhook paths. Leave as-is unless the n8n workflows use different ones.
N8N_PROCESS_PATH=/process-document
N8N_DOCUMENTS_PATH=/documents
N8N_REVIEW_PATH=/review

# Shared secret sent as the x-api-key header. Must match the Header Auth
# credential on the n8n webhooks. Never commit the real value.
N8N_SECRET=replace-me

# Outbound HTTP timeout to n8n, in milliseconds.
REQUEST_TIMEOUT_MS=90000

# Largest file the upload screen will accept, in megabytes (before base64).
MAX_FILE_MB=10

# true  -> every n8n call is served from mock.py, no n8n instance needed.
# false -> real calls to N8N_BASE_URL.
USE_MOCK=true
