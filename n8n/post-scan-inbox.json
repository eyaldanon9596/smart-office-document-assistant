    },
    {
      "id": "getlabels",
      "name": "Get labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [0, 0],
      "parameters": { "resource": "label", "operation": "getAll", "returnAll": true },
      "credentials": { "gmailOAuth2": { "id": "AYgjFyDnQF1fGC7w", "name": "Gmail OAuth2 API" } }
