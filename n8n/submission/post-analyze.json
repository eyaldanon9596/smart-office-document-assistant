    {
      "id": "build",
      "name": "Build the prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -100
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const info = $('Find the document').first().json;\nconst f = info.fields;\nconst text = ($json.text || '').trim() || '(the document text could not be read)';\nconst prompt = [\n  'Already-extracted fields:',\n  `- Document type: ${f.document_type}`,\n  `- Sender / company: ${f.sender_or_company}`,\n  `- Summary: ${f.summary}`,\n  `- Requested action: ${f.requested_action}`,\n  `- Deadline: ${f.deadline}`,\n  `- Urgency: ${f.urgency}`,\n  `- Department: ${f.department}`,\n  '',\n  'Full document text:',\n  text,\n].join('\\n');\nreturn [{ json: { document_id: info.document_id, prompt } }];\n"
      }
    },
    {
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1500,
        -100
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "You are an office document analyst. You are given the full text of a business document (usually an invoice or purchase order) plus the fields already extracted from it. Write a clear briefing for a non-expert office employee, using these headings exactly:\n\n**What this document is** — 2 to 3 sentences: the document type and purpose, who it is from and to, the total amount and currency, and any deadline.\n\n**About the sender** — 2 to 4 sentences on the company that issued it: what industry they are in and what they sell or do. If you are not confident who they are, say so rather than guessing.\n\n**Line items** — one bullet per product or charge. For each: the name as written, the quantity and price if shown, and a plain-language explanation of what the product or service actually is. Example: \"Office 365 Exchange Online Plan 1 — a hosted business email mailbox in the cloud, about 50 GB of storage per user.\"\n\n**Worth a closer look** — anything unusual, missing, inconsistent, or that a person should check before approving. If nothing stands out, say so.\n\n**Recommended next step** — one sentence.\n\nBase everything on the document text provided. Do not invent line items or amounts. Be concise and concrete."
        }
      }
    },
