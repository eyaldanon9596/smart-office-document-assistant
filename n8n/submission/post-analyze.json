    {
      "id": "find",
      "name": "Find the document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const wanted = String(($('Webhook POST analyze').first().json.body || {}).document_id || '').trim();\nconst row = $input.all().map(i => i.json || {}).find(r => String(r['Document ID']).trim() === wanted);\nif (!row) return [{ json: { found: false, document_id: wanted } }];\nconst link = row['File Link'] || '';\nconst m = link.match(/\\/d\\/([^/]+)/) || link.match(/[?&]id=([^&]+)/);\nreturn [{ json: {\n  found: true,\n  document_id: wanted,\n  fileId: m ? m[1] : '',\n  file_name: row['File Name'] || '',\n  fields: {\n    document_type: row['Document Type'] || 'Not found',\n    sender_or_company: row['Sender / Company'] || 'Not found',\n    summary: row['Summary'] || 'Not found',\n    requested_action: row['Requested Action'] || 'No action found',\n    deadline: row['Deadline'] || 'Not found',\n    urgency: row['Urgency'] || 'Not found',\n    department: row['Department'] || 'Not found',\n  },\n} }];\n"
      }
    },
