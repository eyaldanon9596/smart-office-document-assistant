      "parameters": { "modelName": "models/gemini-3.6-flash", "options": { "temperature": 0 } },
      "credentials": {
        "googlePalmApi": { "id": "3Bj78Dc8WJWZwwEF", "name": "Google Gemini(PaLM) Api account" }
      }
    },
    {
      "id": "ie",
      "name": "Information Extractor",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [1340, -120],
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"document_type\": { \"type\": \"string\", \"enum\": [\"invoice\",\"request\",\"report\",\"complaint\",\"contract\",\"quote\",\"other\"] },\n    \"sender_or_company\": { \"type\": \"string\" },\n    \"summary\": { \"type\": \"string\" },\n    \"requested_action\": { \"type\": \"string\" },\n    \"deadline\": { \"type\": \"string\" },\n    \"urgency\": { \"type\": \"string\", \"enum\": [\"Low\",\"Medium\",\"High\"] },\n    \"department\": { \"type\": \"string\", \"enum\": [\"Sales\",\"Finance\",\"Support\",\"HR\",\"Management\",\"General\"] }\n  },\n  \"required\": [\"document_type\",\"sender_or_company\",\"summary\",\"requested_action\",\"deadline\",\"urgency\",\"department\"]\n}",
        "options": {
          "systemPromptTemplate": "Extract the seven business fields. If a value is not present in the document, return exactly \"Not found\" for it, except requested_action, which must be exactly \"No action found\" when absent. Never guess. Use only the allowed enum values."
        }
      }
    },
    {
      "id": "finalize",
      "name": "Finalize fields and status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, -120],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// CONTRACT.md 2.1: 2+ missing business fields => Needs Review.\nconst ie = $json.output || $json;\nconst meta = $('Decode file').first().json;\nconst drive = $('Upload original to Drive').first().json;\nconst F = ['document_type','sender_or_company','summary','requested_action','deadline','urgency','department'];\nconst fields = {}; let missing = 0;\nfor (const k of F) {\n  let v = ie && ie[k];\n  if (v === undefined || v === null || String(v).trim() === '') v = (k === 'requested_action') ? 'No action found' : 'Not found';\n  if (v === 'Not found' || v === 'No action found') missing++;\n  fields[k] = v;\n}\nconst status = missing >= 2 ? 'Needs Review' : 'Processed';\nconst documentId = 'exec-' + ($execution.id || Date.now());\nconst fileLink = drive.webViewLink || drive.webContentLink || '';\nreturn [{ json: {\n  'Document ID': documentId,\n  'Received At': meta.received_at,\n  'File Name': meta.file_name,\n  'File Link': fileLink,\n  'Document Type': fields.document_type,\n  'Sender / Company': fields.sender_or_company,\n  'Summary': fields.summary,\n  'Requested Action': fields.requested_action,\n  'Deadline': fields.deadline,\n  'Urgency': fields.urgency,\n  'Department': fields.department,\n  'Submitted By': meta.submitted_by,\n  'Status': status,\n  'Reviewed By': '',\n  'Review Note': '',\n  _response: { status: 'processed', document_id: documentId, file_name: meta.file_name, file_link: fileLink, received_at: meta.received_at, fields, notification_sent: true },\n  _urgency: fields.urgency\n} }];\n"
      }
    },
    {
      "id": "append",
