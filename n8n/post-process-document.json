    {
      "id": "decode",
      "name": "Decode file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 0],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Turn the base64 payload into a binary property and, for TXT, into text.\nconst body = $json.body || {};\nconst fileName = body.file_name || 'document';\nconst mimeType = body.mime_type || 'application/octet-stream';\nconst buff = Buffer.from(body.file_base64 || '', 'base64');\nconst binary = await this.helpers.prepareBinaryData(buff, fileName, mimeType);\nconst received_at = new Date().toISOString().replace(/\\.\\d{3}Z$/, 'Z');\nlet text = '';\nif (mimeType === 'text/plain') text = buff.toString('utf8');\nreturn [{ json: { file_name: fileName, mime_type: mimeType, submitted_by: body.submitted_by || 'Not found', received_at, text }, binary: { data: binary } }];\n"
      }
    },
    {
      "id": "drive",
      "name": "Upload original to Drive",
      "notes": "Uploads to the 'Smart Office Intake' folder (eyal9596@gmail.com).",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [240, 0],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "={{ $json.file_name }}",
        "driveId": { "__rl": true, "mode": "list", "value": "My Drive" },
        "folderId": { "__rl": true, "mode": "id", "value": "19L3PCxpKXYVg9EKXHKys2PGy4Q0rpUwN" },
        "inputDataFieldName": "data",
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": { "id": "ca58XKLdnQURD47g", "name": "Google Drive account" }
      }
    },
    {
      "id": "ifpdf",
      "name": "Is it a PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [460, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "c_pdf", "leftValue": "={{ $('Decode file').first().json.mime_type }}", "rightValue": "application/pdf", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "extract",
      "name": "Extract text from PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [680, -120],
      "parameters": { "operation": "pdf", "binaryPropertyName": "data", "options": { "joinPages": true } }
    },
    {
      "id": "assemble",
      "name": "Assemble text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, -40],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Carry the extracted text past the Drive-upload node, which replaced $json.\n// PDF branch: text is on the Extract node output ($json.text).\n// TXT branch: text was decoded in 'Decode file'.\nconst meta = $('Decode file').first().json;\nlet text = (meta.text || '').trim();\nif (!text && $json && $json.text) text = String($json.text).trim();\nreturn [{ json: { file_name: meta.file_name, mime_type: meta.mime_type, submitted_by: meta.submitted_by, received_at: meta.received_at, text } }];\n"
      }
    },
    {
      "id": "iftext",
      "name": "Has readable text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1120, -40],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "c_txt", "leftValue": "={{ (($json.text) || '').trim().length > 0 }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        }
      }
    },
    {
