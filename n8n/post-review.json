      "id": "find_row",
      "name": "Find matching row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// CONTRACT.md section 6: match on document_id only, never file name.\nconst body = $('Webhook POST review').first().json.body || {};\nconst wanted = String(body.document_id || '').trim();\nconst status = body.status === 'Needs Review' ? 'Needs Review' : 'Reviewed';\nconst hit = $input.all().find(({ json }) => String(json['Document ID']).trim() === wanted);\nreturn [{ json: {\n  matched: Boolean(hit),\n  'Document ID': wanted,\n  'Status': status,\n  'Reviewed By': body.reviewed_by || '',\n  'Review Note': (body.review_note || '').slice(0, 200),\n} }];\n"
      }
    },
